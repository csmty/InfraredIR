{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug with accelerate",
      "type": "python",
      "request": "launch",
      "module": "accelerate.commands.launch",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}:${env:PYTHONPATH}",
        "NCCL_P2P_DISABLE": "1",
        "NCCL_IB_DISABLE": "1"
      },
      "args": [
        "--num_processes=1",
        "--gpu_ids=0",
        "--main_process_port=29300",
        "src/train_segformer.py",
        "--sd_path=/data/matengyu/code/@submit/Infrared/CVPR26/S3Diff/weight/sd-turbo/models--stabilityai--sd-turbo/snapshots/sd-turbo",
        "--base_config=configs/sr_enhancement_STAGE2.yaml",
        "--output_dir=./experiments/stage2_seg",
        "--train_batch_size=1",
        "--enable_xformers_memory_efficient_attention",
        "--viz_freq=500",
        "--eval_freq=500",
        "--save_val",
        "--pretrained_path=/data/matengyu/code/@submit/Infrared/CVPR26/S3Diff/experiments/debug_Stage1/checkpoints/model_78501.pkl"
      ]
    }
  ]
}